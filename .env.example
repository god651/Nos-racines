# Tout est facultatif : l'application fonctionne sans aucune de ces variables.
# Copiez ce fichier en « .env.local » pour les utiliser.

# Dossier où sont gardées les données de la famille (par défaut : le dossier « donnees » du projet).
# NOS_RACINES_DONNEES=D:\NosRacines\donnees

# Ports du serveur (npm start / npm run telephone).
# PORT=3000
# HTTPS_PORT=3443

# Adresse fixe à imprimer dans les QR codes, si l'application est un jour mise en ligne.
# Sans elle, les QR codes utilisent l'adresse avec laquelle vous avez ouvert l'application.
# NEXT_PUBLIC_SITE_URL=https://nosracines.example

# Clé Google Cloud Translation (facultative, peut aussi se saisir dans Paramètres > Internet).
# GOOGLE_TRANSLATE_API_KEY=
